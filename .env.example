# Development only. The server does not automatically load this file.
APP_ENV=development
APP_ORIGIN=http://localhost:8000
DATA_DIR=.data
# DATABASE_URL defaults to SQLite inside DATA_DIR for local development.
# APP_SECRET is persisted privately in DATA_DIR/session-secret when omitted locally.
STORAGE_BACKEND=local
CODEFORCES_ENABLED=true
CODEFORCES_SYNC_ENABLED=false
CIRCLES_ENABLED=true
USER_QUOTA_BYTES=33554432
TEACHER_QUOTA_BYTES=134217728
STORAGE_SOFT_LIMIT_BYTES=524288000
STORAGE_HARD_LIMIT_BYTES=734003200
