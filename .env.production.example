# Server-only template. Set actual secrets in the host secret store, not in git.
# No cloud deployment or school-data import has been performed for this milestone.
APP_ENV=production
APP_ORIGIN=https://YOUR-SERVICE.onrender.com
APP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Copy your actual SESSION pooler hostname, use olympiados_app.PROJECT_REF.
# Percent-encode the password. Configure the actual trusted CA via sslrootcert.
DATABASE_URL=postgresql+psycopg://olympiados_app.PROJECT_REF:ENCODED_PASSWORD@COPIED_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/postgres-ca.crt
DB_SCHEMA=olympiados
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DATA_DIR=/tmp/olympiados
STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=olympiados-attachments
SUPABASE_STORAGE_SERVER_KEY=REPLACE_WITH_SERVER_ONLY_SECRET_KEY
USER_QUOTA_BYTES=33554432
TEACHER_QUOTA_BYTES=134217728
STORAGE_SOFT_LIMIT_BYTES=524288000
STORAGE_HARD_LIMIT_BYTES=734003200
CODEFORCES_ENABLED=true
CODEFORCES_SYNC_ENABLED=false
CIRCLES_ENABLED=true
# Supply only verified host proxy ranges. Do not blindly trust all internet IPs.
TRUSTED_PROXY_IPS=127.0.0.1
# MIGRATION_DATABASE_URL belongs ONLY on the school operator's workstation.
